{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:dev": "vue-tsc --build && vite build --mode development",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.1",
    "@wailsio/runtime": "^3.0.0-alpha.72",
    "vue": "^3.6.0-alpha.2",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.23.0",
    "typescript": "^5.9.3",
    "unplugin-vue-router": "^0.16.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "bun@latest"
}
